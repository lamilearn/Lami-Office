# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & credentials. Profiles are committed; anything with real values
# is not. The negation below must come first: git applies the last matching rule,
# so a trailing `.env.*.secrets` would otherwise be overridden by the `!` lines.
!.env.example
!.env.production
!.env.development
.env
.env.local
.env.*.local
.env.*.secrets
*.pem
*.key
*.cert
*.crt

# OS / IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Build & test outputs
dist/
build/
*.egg-info/

# Logs & temp files
*.log
logs/
tmp/
temp/
