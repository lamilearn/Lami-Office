# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# Allow tracked env configuration profiles
!.env.example
!.env.production
!.env.development

# OS / IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Build & test outputs
dist/
build/
*.egg-info/

# Logs & temp files
*.log
logs/
tmp/
temp/
