# Lami AI Office Suite — Environment Configuration Template
# Copy to .env or use with --env-file <file>

# Docker Compose project name prefix for container naming & isolation
COMPOSE_PROJECT_NAME=office

# Runtime environment profile (production | development)
ENVIRONMENT=production

# ai-office host port mapping (maps to container port 80)
AI_OFFICE_PORT=8088

# lami-office-react host port mapping (maps to container port 8090)
LAMI_OFFICE_PORT=8090

# Public mode for lami-office-react (live | demo)
PUBLIC_MODE=live

# Hermes agent root directory on host for sqlite state and logs
HERMES_HOME=~/.hermes
