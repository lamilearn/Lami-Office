# Lami AI Office Suite — Environment Configuration Template
# Copy to .env or use with --env-file <file>

# Docker Compose project name prefix for container naming & isolation
COMPOSE_PROJECT_NAME=office

# Runtime environment profile (production | development)
ENVIRONMENT=production

# ai-office host port mapping (maps to container port 80)
AI_OFFICE_PORT=8088

# lami-office-react host port mapping (maps to container port 8090)
LAMI_OFFICE_PORT=8090

# Public mode for lami-office-react (live | demo)
PUBLIC_MODE=live

# Hermes agent root directory on host for sqlite state and logs
HERMES_HOME=~/.hermes

# Shared secret for remote event ingest (Hermes bridge on another host).
# Leave empty only when Hermes runs on the same host as the office.
INGEST_TOKEN=

# ---- A2A peer agents (Hermes A2A sidecars on the LAN) ----
# Shared secret the sidecars expect in the x-a2a-token header. Empty = presence
# only (agents show online/offline, but sending messages is disabled).
A2A_SECRET=
# How often (seconds) the office pings each peer's /health endpoint.
A2A_POLL_INTERVAL=10
# Peer list as JSON. Defaults live in services/lami-office-react/server.py.
# A2A_PEERS=[{"id":"yuna","name":"Yuna","host":"192.168.3.91","port":8000,"room":"research"}]
