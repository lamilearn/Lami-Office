# Lami AI Office Suite — Development Environment Configuration
# Ports 18088 / 13579, project office-dev

COMPOSE_PROJECT_NAME=office-dev
ENVIRONMENT=development
AI_OFFICE_PORT=18088
LAMI_OFFICE_PORT=13579
PUBLIC_MODE=demo
HERMES_HOME=/home/rumi/.hermes

# ---- A2A peer agents ----
# Peers are auto-detected: the official A2A v1.0 endpoint (Agent Card +
# JSON-RPC SendMessage) is probed first, then the legacy sidecar /health.
#   Lami  -> http://192.168.3.31:9900  (Hermes gateway, official A2A)
#   Yuna/Aurora/Kira/Cyro -> 192.168.3.91-94:8000 (custom sidecars)
# Token for the official endpoint (Bearer). Empty = presence only.
A2A_PEER_TOKENS=
# Shared secret for the legacy sidecars (x-a2a-token header).
A2A_SECRET=
# How often (seconds) peers are probed.
A2A_POLL_INTERVAL=10
# Seconds to wait for an official A2A task reply.
A2A_REPLY_TIMEOUT=120
# Peer list override as JSON (defaults live in server.py).
# A2A_PEERS=[{"id":"lami","host":"192.168.3.31","port":9900,"protocol":"a2a"}]
