# Lami AI Office Suite — Production Environment Configuration
# Ports 8088 / 8090, project office-prod

COMPOSE_PROJECT_NAME=office-prod
ENVIRONMENT=production
AI_OFFICE_PORT=8088
LAMI_OFFICE_PORT=8090
PUBLIC_MODE=live
HERMES_HOME=/home/rumi/.hermes

# ---- A2A peer agents (Hermes A2A sidecars on the LAN) ----
# Shared secret the sidecars expect in the x-a2a-token header. Empty = presence
# only (agents show online/offline, but sending messages is disabled).
A2A_SECRET=
# How often (seconds) the office pings each peer's /health endpoint.
A2A_POLL_INTERVAL=10
# Peer list as JSON. Defaults live in services/lami-office-react/server.py.
# A2A_PEERS=[{"id":"yuna","name":"Yuna","host":"192.168.3.91","port":8000,"room":"research"}]
